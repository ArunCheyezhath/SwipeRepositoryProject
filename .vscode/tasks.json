{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "npm install",
      "type": "shell",
      "command": "npm",
      "args": ["install"],
      "group": {
        "kind": "build",
        "isDefault": true
      }
    },
    {
      "label": "npm dev",
      "type": "shell",
      "command": "npm",
      "args": ["run", "dev"],
      "isBackground": true
    },
    {
      "label": "npm build",
      "type": "shell",
      "command": "npm",
      "args": ["run", "build"]
    }
  ]
}
