{
  "ConnectionStrings": {
    "MongoDB": "mongodb://localhost:27017/TimeSmart"
  },
  "Jwt": {
    "Key": "dev-only-signing-key-change-this-before-any-real-deployment-32bytes+",
    "Issuer": "TimeSmart",
    "Audience": "TimeSmartClient",
    "AccessTokenMinutes": 15,
    "RefreshTokenDays": 7
  },
  "GoogleAuth": {
    "ClientId": "YOUR_GOOGLE_CLIENT_ID",
    "ClientSecret": "YOUR_GOOGLE_CLIENT_SECRET"
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "TimeSmart": "Debug"
    },
    "LogFilePath": "logs/timesmart-.txt"
  }
}
